+    def test_cancelled_submit_does_not_write_or_commit(self):
+        connection = mock.Mock()
+        connection.execute.return_value.fetchone.return_value = ("cancelled",)
+        self.assertFalse(order_service.submit_order(connection, "ORDER-1"))
+        connection.execute.assert_called_once_with(
+            "SELECT status FROM orders WHERE order_id = ?", ("ORDER-1",)
+        )
+        connection.commit.assert_not_called()
+
+    def test_submit_read_error_propagates(self):
+        connection = mock.Mock()
+        failure = sqlite3.OperationalError("read failed")
+        connection.execute.side_effect = failure
+        with self.assertRaises(sqlite3.OperationalError) as raised:
+            order_service.submit_order(connection, "ORDER-1")
+        self.assertIs(raised.exception, failure)
+        connection.commit.assert_not_called()
+
+    def test_submit_write_and_commit_errors_propagate(self):
+        for failing_operation in ("write", "commit"):
+            with self.subTest(failing_operation=failing_operation):
+                connection = mock.Mock()
+                cursor = mock.Mock()
+                cursor.fetchone.return_value = ("pending",)
+                failure = sqlite3.OperationalError(f"{failing_operation} failed")
+
+                def execute(statement, parameters):
+                    if statement.startswith("UPDATE") and failing_operation == "write":
+                        raise failure
+                    return cursor
+
+                connection.execute.side_effect = execute
+                if failing_operation == "commit":
+                    connection.commit.side_effect = failure
+                with self.assertRaises(sqlite3.OperationalError) as raised:
+                    order_service.submit_order(connection, "ORDER-1")
+                self.assertIs(raised.exception, failure)
+                if failing_operation == "write":
+                    connection.commit.assert_not_called()
+
