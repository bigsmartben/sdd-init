est, \\\"actual\\\": hashlib.sha256(Path(name).read_bytes()).hexdigest()} for name, digest in expected.items()}\\nfor value in checks.values():\\n    value[\\\"matches\\\"] = value[\\\"expected\\\"] == value[\\\"actual\\\"]\\nreuse = {}\\nfor name in (\\\"unit-red.json\\\", \\\"unit-green.json\\\", \\\"ac1-green.json\\\"):\\n    path = base / \\\"implementation\\\" / name\\n    record = json.loads(path.read_text(encoding=\\\"utf-8-sig\\\"))\\n    reuse[name] = {\\\"path\\\": path.as_posix(), \\\"sha256\\\": hashlib.sha256(path.read_bytes()).hexdigest(), \\\"record\\\": record}\\n    if name != \\\"unit-red.json\\\":\\n        reuse[name][\\\"matches_candidate_before_and_after\\\"] = all(record[phase].get(key) == digest for phase in (\\\"sha256_before\\\", \\\"sha256_after\\\") for key, digest in expected.items())\\nread_paths = [\\\"src/__init__.py\\\", \\\"src/ui.py\\\", \\\"src/order_service.py\\\", \\\"src/storage.py\\\", \\\"tests/test_order.py\\\", \\\"docs/test-reports/order/evidence/implementation/changes.diff\\\", \\\"docs/test-reports/order/20261115-payment-review.md\\\"]\\ntexts = {path: Path(path).read_text(encoding=\\\"utf-8-sig\\\") for path in read_paths}\\nreport = {\\\"task\\\": \\\"CHK-001\\\", \\\"matrix\\\": \\\"RM-001\\\", \\\"reviewer\\\": \\\"/root/forward_work_order/architect_initial\\\", \\\"caller\\\": \\\"/root/forward_work_order\\\", \\\"timestamp_utc\\\": datetime.now(timezone.utc).isoformat(), \\\"cwd\\\": str(root), \\\"environment\\\": {\\\"python\\\": sys.version, \\\"executable\\\": sys.executable, \\\"platform\\\": platform.platform(), \\\"sqlite\\\": sqlite3.sqlite_version}, \\\"candidate_path\\\": (base / \\\"implementation/candidate-v1.json\\\").as_posix(), \\\"candidate\\\": candidate, \\\"independent_hash_checks\\\": checks, \\\"reused_evidence\\\": reuse, \\\"read_source_and_diff_and_review\\\": texts, \\\"new_behavior_test_execution\\\": False, \\\"temporary_data_created\\\": False}\\noutput = base / \\\"architecture-recheck/