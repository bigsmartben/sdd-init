    "sha256": "df32f50f89b59e65df1a008279908d6f639259c2c10179f341f92360a8c742b4",
    "utf8_content": "\"\"\"Local regressions for CHK-001; formal acceptance uses checks separately.\"\"\"\r\nfrom pathlib import Path\r\nimport sqlite3\r\nimport tempfile\r\nimport unittest\r\nfrom unittest.mock import patch\r\n\r\nfrom src import order_service, storage, ui\r\n\r\n\r\nclass FailingConnection:\r\n    \"\"\"Inject one database failure around a real caller-owned connection.\"\"\"\r\n\r\n    def __init__(self, connection, operation, error):\r\n        self.connection = connection\r\n        self.operation = operation\r\n        self.error = error\r\n\r\n    def execute(self, statement, parameters=()):\r\n        if statement.startswith(self.operation):\r\n            raise self.error\r\n        return self.connection.execute(statement, parameters)\r\n\r\n    def commit(self):\r\n        if self.operation == \"commit\":\r\n            raise self.error\r\n        return self.connection.commit()\r\n\r\n\r\nclass OrderTests(unittest.TestCase):\r\n    def setUp(self):\r\n        self.directory = tempfile.TemporaryDirectory()\r\n        self.addCleanup(self.directory.cleanup)\r\n        self.path = Path(self.directory.name) / \"orders.sqlite\"\r\n        self.connection = storage.connect(self.path)\r\n        self.addCleanup(self.connection.close)\r\n        order_service.create_order(self.connection, \"ORDER-1\")\r\n\r\n    def test_normal_submit(self):\r\n        self.assertTrue(order_service.submit_order(self.connection, \"ORDER-1\"))\r\n        self.assertEqual(order_service.read_status(self.connection, \"ORDER-1\"), \"submitted\")\r\n\r\n    def test_mark_paid_calls_real_service_writer(self):\r\n        with patch.object(order_service, \"set_status\", wraps=order_service.set_status) as writer:\r\n            self.assertIsNone(ui.mark_paid(self.connection, \"ORDER-1\"))\r\n            writer.assert_called_once_with(self.connection, \"ORDER-1\", \"paid\")\r\n        self.assertEqual(order_service.read_status(self.connection, \"ORDER-1\"), \"paid\")\r\n\r\n    def test_mark_paid_is_persisted(self):\r\n        for initial_status in (\"pending\", \"cancelled\", \"submitted\", \"paid\"):\r\n            with self.subTest(initial_status=initial_status):\r\n                order_service.set_status(self.connection, \"ORDER-1\", initial_status)\r\n                self.assertIsNone(ui.mark_paid(self.connection, \"ORDER-1\"))\r\n                self.assertEqual(order_service.read_status(self.connection, \"ORDER-1\"), \"paid\")\r\n                other = storage.connect(self.path)\r\n                try:\r\n                    self.assertEqual(order_service.read_status(other, \"ORDER-1\"), \"paid\")\r\n                finally:\r\n                    other.close()\r\n\r\n    def test_mark_paid_missing_order_propagates_value_error(self):\r\n        with self.assertRaises(ValueError):\r\n            ui.mark_paid(self.connection, \"MISSING\")\r\n        self.assertEqual(self.connection.execute(\"SELECT COUNT(*) FROM orders WHERE order_id = ?\", (\"MISSING\",)).fetchone()[0], 0)\r\n        self.assertEqual(order_service.read_status(self.connection, \"ORDER-1\"), \"pending\")\r\n\r\n    def test_mark_paid_database_errors_propagate_and_leave_connection_to_caller(self):\r\n        for operation in (\"SELECT\", \"UPDATE\", \"commit\"):\r\n            with self.subTest(operation=operation):\r\n                error = sqlite3.OperationalError(\"injected \" + operation)\r\n                connection = FailingConnection(self.connection, operation, error)\r\n                with self.assertRaises(sqlite3.OperationalError) as raised:\r\n                    ui.mark_paid(connection, \"ORDER-1\")\r\n                self.assertIs(raised.exception, error)\r\n                self.assertEqual(self.connection.execute(\"SELECT 1\").fetchone(), (1,))\r\n                self.connection.rollback()\r\n                other = storage.connect(self.path)\r\n                try:\r\n                    self.assertEqual(order_service.read_status(other, \"ORDER-1\"), \"pending\")\r\n                finally:\r\n                    other.close()\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    unittest.main()\r\n"
  },
