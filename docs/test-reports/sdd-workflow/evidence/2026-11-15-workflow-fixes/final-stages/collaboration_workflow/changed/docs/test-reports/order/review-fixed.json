  "sources": {
    "src/ui.py": "\"\"\"UI adapter surface in the evaluation fixture (there is no graphical UI).\"\"\"\n\nfrom . import order_service\n\n\ndef mark_paid(connection, order_id):\n    order_service.set_status(connection, order_id, \"paid\")\n",
    "src/__init__.py": "\"\"\"Runtime modules of the isolated evaluation fixture.\"\"\"\n",
    "src/storage.py": "\"\"\"SQLite connection boundary for the evaluation fixture.\"\"\"\nimport sqlite3\n\n\ndef connect(path):\n    connection = sqlite3.connect(path)\n    connection.execute(\"CREATE TABLE IF NOT EXISTS orders (order_id TEXT PRIMARY KEY, status TEXT NOT NULL)\")\n    connection.commit()\n    return connection\n",
    "src/order_service.py": "\"\"\"Order operations in the intentionally imperfect evaluation fixture.\"\"\"\n\n\ndef create_order(connection, order_id):\n    if not isinstance(order_id, str) or not order_id:\n        raise ValueError(\"order_id is required\")\n    connection.execute(\"INSERT INTO orders VALUES (?, ?)\", (order_id, \"pending\"))\n    connection.commit()\n\n\ndef read_status(connection, order_id):\n    row = connection.execute(\"SELECT status FROM orders WHERE order_id = ?\", (order_id,)).fetchone()\n    if row is None:\n        raise ValueError(\"order not found\")\n    return row[0]\n\n\ndef set_status(connection, order_id, status):\n    read_status(connection, order_id)\n    connection.execute(\"UPDATE orders SET status = ? WHERE order_id = ?\", (status, order_id))\n    connection.commit()\n\n\ndef cancel_order(connection, order_id):\n    set_status(connection, order_id, \"cancelled\")\n\n\ndef submit_order(connection, order_id):\n    if read_status(connection, order_id) == \"cancelled\":\n        return False\n    set_status(connection, order_id, \"submitted\")\n    return True\n"
  },
