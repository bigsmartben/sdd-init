{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdd.local/schemas/observability-event-1.0.0.json",
  "title": "SDD observability event",
  "type": "object",
  "required": [
    "schema_version",
    "event_id",
    "project",
    "service",
    "program_version",
    "instance_id",
    "event_time_unix_nano",
    "observed_time_unix_nano",
    "session_id",
    "request_id",
    "call_id",
    "trace_id",
    "span_id",
    "stage",
    "sequence",
    "event_type",
    "severity",
    "result",
    "error",
    "content",
    "save_state",
    "integrity"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "service": {
      "type": "string",
      "minLength": 1
    },
    "program_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "instance_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "event_time_unix_nano": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "observed_time_unix_nano": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "session_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "request_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "call_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "trace_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "span_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "stage": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "event_type": {
      "type": "string",
      "minLength": 1
    },
    "severity": {
      "enum": [
        "TRACE",
        "DEBUG",
        "INFO",
        "WARN",
        "ERROR",
        "FATAL"
      ]
    },
    "result": {
      "enum": [
        "success",
        "failure",
        "unknown",
        "not_applicable"
      ]
    },
    "error": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": [
                "string",
                "null"
              ]
            },
            "message": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "content": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "text",
            "media_uri",
            "media_sha256"
          ],
          "properties": {
            "kind": {
              "enum": [
                "text",
                "media",
                "none"
              ]
            },
            "text": {
              "type": [
                "string",
                "null"
              ]
            },
            "media_uri": {
              "type": [
                "string",
                "null"
              ]
            },
            "media_sha256": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "save_state": {
      "enum": [
        "not_attempted",
        "accepted",
        "collector_received",
        "backend_readback",
        "failed",
        "unknown"
      ]
    },
    "integrity": {
      "enum": [
        "complete",
        "partial",
        "missing",
        "unknown",
        "not_applicable"
      ]
    }
  },
  "additionalProperties": false
}
